# Copy to .env (never commit .env). CivAlpha works on real data: set at least SEC_USER_AGENT and a price source.

POSTGRES_PASSWORD=civalpha
CIVALPHA_PORT=8088
# Interface the UI is published on. Keep 127.0.0.1 unless you add authentication in front of /api/admin.
CIVALPHA_BIND=127.0.0.1
# Shared secret for /api/admin/** and all write requests (X-Admin-Token header). Set it before exposing the UI
# beyond localhost; the Data & pipeline page asks for it when required.
CIVALPHA_ADMIN_TOKEN=

# --- MCP endpoint for AI assistants (http://localhost:8088/mcp) -----------
# The endpoint only accepts requests whose Host header is localhost / 127.0.0.1 (DNS-rebinding protection).
# When CIVALPHA_BIND is another interface, list the host names clients will use (comma-separated, "name" or "name:*"),
# e.g. CIVALPHA_MCP_ALLOWED_HOSTS=research.lan:*  and, for browser-based clients, their origins.
CIVALPHA_MCP_ALLOWED_HOSTS=
CIVALPHA_MCP_ALLOWED_ORIGINS=

# --- Schedule (cron run by the worker; 6 fields = sec min hour day month weekday, 5 = standard; "-" = off)
# e.g. pipeline after the US close on weekdays, outcomes shortly after
CIVALPHA_PIPELINE_CRON=-
CIVALPHA_OUTCOMES_CRON=-
CIVALPHA_SCHEDULE_ZONE=America/New_York

# --- SEC EDGAR (filings, XBRL facts) ----------------------------------------
# Required by the SEC fair-access policy: identify yourself and a contact e-mail, e.g. "CivAlpha Jane Doe jane@example.com".
SEC_USER_AGENT=
# SEC allows at most 10 requests/second; the client refuses higher values.
SEC_MAX_RPS=5
SEC_LOOKBACK_YEARS=6

# --- Daily prices (automatic) ----------------------------------------------
# none = CSV import only. yahoo = no key, unofficial (personal research only; Yahoo's terms restrict
# automated use and redistribution). tiingo = free key at tiingo.com (check the plan's terms for your use).
CIVALPHA_PRICE_PROVIDER=none
TIINGO_API_KEY=
# first date downloaded for a stock or ETF without any stored prices
CIVALPHA_PRICE_HISTORY_START=2019-01-02

# --- FRED / ALFRED macro series (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# --- Official event feeds and optional news discovery ----------------------
EVENTS_FEDERAL_REGISTER_ENABLED=false
EVENTS_FED_RSS_ENABLED=false
# Comma-separated RSS URLs used for discovery only (events stay NEWS_ONLY until an official source is linked)
EVENTS_NEWS_FEEDS=

# --- Optional LLM-assisted exposure extraction ------------------------------
# none (default) or anthropic. Without a key the application runs unchanged.
CIVALPHA_LLM_PROVIDER=none
CIVALPHA_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Optional: corporate-action detector on 8-K text with TypeSafe AI's Jev (ADR-0003) ------------------------
# Key from https://console.typesafe.ai/keys. Without it only the free keyword rule runs. The model stays pinned so
# results do not change when TypeSafe ships a release; the versioned id that answered is stored with every result.
TYPESAFE_API_KEY=
CIVALPHA_JEV_MODEL=jev-1.13.0
# How the model's review of the AI's ENTER decisions is used: off | advisory (logged, decision unchanged) | veto
# (a DISAGREE is stored as STAY_OUT). Needs the provider above.
CIVALPHA_LLM_REVIEW=advisory
